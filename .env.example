# Client-facing credentials (shared across all backends)
CLIENT_ACCESS_KEY=
CLIENT_SECRET_KEY=

# Server A credentials
SERVERA_ORIGIN_ACCESS_KEY=
SERVERA_ORIGIN_HOST=
# Origin health check path (default "/"; e.g. /minio/health/live for MinIO)
SERVERA_ORIGIN_HEALTH_PATH=/
# Origin port (defaults to 443 if unset)
SERVERA_ORIGIN_PORT=
SERVERA_ORIGIN_REGION=us-east-1
SERVERA_ORIGIN_SCHEME=
SERVERA_ORIGIN_SECRET_KEY=

# Server B credentials
SERVERB_ORIGIN_ACCESS_KEY=
SERVERB_ORIGIN_HOST=
# Origin health check path (default "/"; e.g. /minio/health/live for MinIO)
SERVERB_ORIGIN_HEALTH_PATH=/
# Origin port (defaults to 443 if unset)
SERVERB_ORIGIN_PORT=
SERVERB_ORIGIN_REGION=us-east-1
SERVERB_ORIGIN_SCHEME=
SERVERB_ORIGIN_SECRET_KEY=

